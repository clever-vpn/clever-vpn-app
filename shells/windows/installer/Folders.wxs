<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- 安装目录固定 CleverVpn：kit 会把该目录里的 CleverVpn.exe 注册成 broker 服务，
         品牌改名不能改变服务路径。 -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CleverVpn" />
    </StandardDirectory>
  </Fragment>
</Wix>
